{
  "name": "feedbackhub",
  "private": true,
  "version": "0.1.0",
  "description": "Internal product feedback board",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "up": "docker compose up -d",
    "down": "docker compose down",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose stop mysql",
    "db:reset": "docker compose down -v && docker compose up -d",
    "auth:up": "docker compose up -d keycloak",
    "auth:google": "node --env-file-if-exists=.env keycloak/add-google-provider.mjs",
    "migrate": "npm run migrate --workspace api",
    "migrate:down": "npm run migrate:down --workspace api",
    "seed": "npm run seed --workspace api",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm start --workspace web",
    "test": "npm test --workspace api && npm test --workspace web",
    "typecheck": "npm run typecheck --workspace api && npm run typecheck --workspace web",
    "build": "npm run build --workspace api && npm run build --workspace web",
    "demo": "npm run demo --workspace api"
  }
}

{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true
  },
  // test/ holds the L1 suite, which is typechecked here and compiled nowhere:
  // tsconfig.build.json includes src only, so none of it can reach dist/.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "vitest.l1.config.ts"],
  "exclude": []
}

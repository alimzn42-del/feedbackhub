# Copy to .env before running anything: cp .env.example .env
# Every value the application reads is declared here. Nothing is hardcoded.

NODE_ENV=development
API_PORT=3000

# Origin allowed to call the API cross-site. The dev proxy in web/proxy.conf.json
# means the browser normally talks to the API same-origin, so this is a fallback
# for running `ng serve` without the proxy.
WEB_ORIGIN=http://localhost:4200

# --- Database -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=feedbackhub
DB_USER=feedbackhub
DB_PASSWORD=feedbackhub
DB_CONNECTION_LIMIT=10

# Used only by docker-compose to initialise the container. The application
# never connects as root.
DB_ROOT_PASSWORD=root

# --- Identity -------------------------------------------------------------
# Keycloak. The realm is imported from keycloak/realm-feedbackhub-development.json
# when the container starts; there is nothing to set up by hand.
#
# The issuer is also the `iss` claim of every token, so the port here, the port
# published in docker-compose.yml and the port the browser is sent to all have
# to be the same one. The API derives the key set from this URL rather than
# taking a second variable that could disagree with it.
KEYCLOAK_PORT=8080
OIDC_ISSUER_URL=http://localhost:8080/realms/feedbackhub
OIDC_AUDIENCE=feedbackhub-api
OIDC_CLIENT_ID=feedbackhub-web

# The realm's ADDRESS, when it is not the same as its identity above.
#
# Leave it unset when running the API from a terminal: localhost:8080 is both.
# It is set for you inside docker-compose, where the browser reaches Keycloak at
# localhost:8080 and the API reaches the same server at keycloak:8080 — the
# token says localhost either way, because the browser is what asked for it.
#
# `iss` is only ever compared to OIDC_ISSUER_URL. This decides where the public
# keys are fetched from and nothing else.
# OIDC_INTERNAL_URL=http://keycloak:8080/realms/feedbackhub

# Where the web tier is published when the whole system runs in containers.
WEB_PORT=4200

# Where the development realm's email is shown. Registering an account ends
# with a verification link, and Mailpit is where it lands — nothing leaves the
# laptop. See the `mailpit` service in docker-compose.yml.
MAILPIT_PORT=8025

# Optional. Seconds of leeway on token expiry, for a machine whose clock drifts.
# Zero by default: a generous allowance is an expired token being accepted
# without anybody having decided that.
# OIDC_CLOCK_TOLERANCE_SECONDS=0

# The Keycloak admin account, created by docker-compose. Only needed for
# `npm run auth:google` and for the admin console, which you should not need.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional: Google as a second sign-in method. Leave these unset and the board
# signs in with email and password, which is a complete, working system — the
# sign-in page simply does not offer a Google button. With them set, run
# `npm run auth:google` once to add the provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Running without Keycloak ----------------------------------------------
# There is a second identity mode: a development seam that makes every request
# the seeded user named below. It is how this board was built before
# authentication existed, and it is retained so the API can be run without a
# container.
#
# To use it, change IDENTITY_MODE in api/src/auth/identity-mode.ts to
# 'development-seam', set the variable below, and REMOVE the three OIDC_ lines
# above — setting both is a boot failure, on purpose, so that nobody has to
# guess which one is in effect.
#
# The API refuses to start at all when NODE_ENV=production while the seam is
# compiled in. It authenticates nobody.
#
# Seeded choices: admin@feedbackhub.local, dana@feedbackhub.local, sam@feedbackhub.local
# DEV_CURRENT_USER_EMAIL=admin@feedbackhub.local

# Copy to .env before running anything: cp .env.example .env
# Every value the application reads is declared here. Nothing is hardcoded.

NODE_ENV=development
API_PORT=3000

# Origin allowed to call the API cross-site. The dev proxy in web/proxy.conf.json
# means the browser normally talks to the API same-origin, so this is a fallback
# for running `ng serve` without the proxy.
WEB_ORIGIN=http://localhost:4200

# --- Database -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=feedbackhub
DB_USER=feedbackhub
DB_PASSWORD=feedbackhub
DB_CONNECTION_LIMIT=10

# Used only by docker-compose to initialise the container. The application
# never connects as root.
DB_ROOT_PASSWORD=root

# --- Identity -------------------------------------------------------------
# DEVELOPMENT ONLY. Selects which seeded user every request runs as, so the
# authorization rules can be exercised before authentication exists.
# The API refuses to start when NODE_ENV=production while the development
# identity seam is compiled in. See api/src/auth/identity-mode.ts.
#
# Seeded choices: admin@feedbackhub.local, dana@feedbackhub.local, sam@feedbackhub.local
DEV_CURRENT_USER_EMAIL=admin@feedbackhub.local
